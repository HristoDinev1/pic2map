# ---- Server ----
CORS_ORIGIN=http://localhost
# Absolute base URL of this API (used in local-storage upload/media URLs)
APP_URL=http://localhost/w26/pic2map/backend/public
# HMAC secret for local tokens & signed URLs (auto-generated into .app-secret if unset)
#APP_SECRET=change-me-to-a-long-random-string

# ---- Drivers ----
# local  = fully self-hosted: accounts + files on this backend, photos
#          processed in PHP (exif + GD) — no AWS required.
# s3 / cognito = the original AWS setup (Lambda does the processing).
# Default "auto": AWS drivers are picked only when real AWS values are configured.
AUTH_DRIVER=local
STORAGE_DRIVER=local
# Where the local driver stores originals + derivatives (default: backend/storage)
#STORAGE_DIR=
#MAX_UPLOAD_BYTES=52428800

# ---- MySQL / MariaDB ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pic2map
DB_USER=pic2map
DB_PASSWORD=pic2map

# ---- AWS (only for STORAGE_DRIVER=s3 / AUTH_DRIVER=cognito) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
