# ---- Server ----
CORS_ORIGIN=http://localhost:5173

# ---- MySQL / MariaDB ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pic2map
DB_USER=pic2map
DB_PASSWORD=pic2map

# ---- AWS (kept: S3 storage + Cognito auth, called directly via signed HTTPS — no SDK) ----
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

S3_BUCKET=pic2map-media-dev
S3_PUBLIC_BASE_URL=        # optional CloudFront/CDN base, else presigned URLs are used

# ---- Cognito ----
COGNITO_USER_POOL_ID=eu-central-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
